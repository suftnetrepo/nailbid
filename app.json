{
  "expo": {
    "name": "NailBid",
    "slug": "quickbid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suftnet.quickbid",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8470A"
      },
      "package": "com.suftnet.quickbid"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NailBid uses Face ID to unlock the app so your business and customer data stays protected."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NailBid uses your photo library to set your business logo, shown on exported quotes and invoices.",
          "cameraPermission": "NailBid uses the camera to scan your business logo, shown on exported quotes and invoices."
        }
      ]
    ],
    "scheme": "quickbid",
    "experiments": {
      "typedRoutes": true
    }
  }
}
